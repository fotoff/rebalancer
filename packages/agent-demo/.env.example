# The agent's own wallet. Needs a little ETH on Base for gas, and USDC only if
# you run with --pay (each signal costs $0.01). It never holds the traded funds.
AGENT_PRIVATE_KEY=0x...

# The AgentVault you were granted permission on (the owner deploys it at
# https://tokenrebalancer.com/agent-vault and authorises your address there).
AGENT_VAULT_ADDRESS=0x...

# Optional
BASE_RPC_URL=https://mainnet.base.org
REBALANCER_API=https://tokenrebalancer.com
FROM_TOKEN=0x4200000000000000000000000000000000000006
TO_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
TRADE_FRACTION=0.25
INTERVAL_MS=900000
